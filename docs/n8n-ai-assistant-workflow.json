{
  "name": "Invest Eval — ИИ-ассистент (вебхук)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "finassist",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "a1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "// Собираем сообщения из запроса сервиса: { system, messages, context }\nconst b = $input.first().json.body || $input.first().json;\nconst history = (b.messages || []).map(m => ({ role: m.role, content: m.content }));\nconst last = history.length ? history[history.length - 1].content : '';\nreturn [{ json: { system: b.system || '', history, prompt: last, context: b.context || {} } }];"
      },
      "id": "a2",
      "name": "Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            { "role": "system", "content": "={{ $json.system }}" },
            { "role": "user", "content": "={{ $json.prompt }}" }
          ]
        },
        "options": { "temperature": 0.2 }
      },
      "id": "a3",
      "name": "OpenAI Chat",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [440, 0],
      "credentials": {
        "openAiApi": { "id": "REPLACE_ME", "name": "OpenAI account" }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"reply\": $json.message?.content ?? $json.output ?? $json.text ?? JSON.stringify($json) } }}",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" },
              { "name": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
            ]
          }
        }
      },
      "id": "a4",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 0]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Prepare", "type": "main", "index": 0 }]] },
    "Prepare": { "main": [[{ "node": "OpenAI Chat", "type": "main", "index": 0 }]] },
    "OpenAI Chat": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
